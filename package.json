{
  "name": "crypto-lab-dnssec-chain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "playwright test --project=a11y",
    "test:claims": "playwright test --project=claims",
    "test:e2e:all": "playwright test",
    "capture": "bash scripts/capture-chain.sh",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "playwright": "^1.62.1",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0"
  }
}
